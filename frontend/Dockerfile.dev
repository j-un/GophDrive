ARG NODE_VERSION=24
FROM node:${NODE_VERSION}-bookworm

WORKDIR /app

# Install dependencies based on package.json
COPY package.json package-lock.json ./
RUN npm install

# Copy source code
COPY . .

# Expose port (Next.js Dev Server)
EXPOSE 3000

# Run npm install on startup to ensure node_modules is always up-to-date,
# then run chokidar proxy for macOS Docker polling issues alongside Next.js
CMD npm install && node watcher.js & npm run dev
