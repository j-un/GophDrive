{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  enabledManagers: [
    'gomod',
    'npm',
    'docker-compose',
    'github-actions',
    'custom.regex',
  ],
  separateMajorMinor: true,
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  // Supply-chain attack hardening: wait 7 days after a release before opening a PR.
  // Compromised versions are usually yanked / disclosed within this window.
  minimumReleaseAge: '7 days',
  postUpdateOptions: [
    'gomodTidy',
  ],
  schedule: [
    'on Sunday',
  ],
  automerge: true,
  automergeType: 'branch',
  platformAutomerge: true,
  packageRules: [
    // eslint-plugin-react (dep of eslint-config-next) does not support ESLint 10 yet.
    // Remove this constraint once eslint-plugin-react adds ESLint 10 to its peerDependencies.
    // Tracking: https://github.com/jsx-eslint/eslint-plugin-react/issues/3838
    {
      matchPackageNames: ['eslint'],
      matchFileNames: ['frontend/package.json'],
      allowedVersions: '<10.0.0',
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
    },
    {
      matchManagers: [
        'gomod',
      ],
      groupName: 'golang dependencies',
    },
    {
      matchManagers: [
        'npm',
      ],
      groupName: 'nodejs dependencies',
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      groupName: 'docker dependencies',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions dependencies',
      pinDigests: true,
    },
    {
      matchPackageNames: [
        'golang',
        'node',
      ],
      groupName: 'tooling versions',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)\\.tool-versions$/',
      ],
      matchStrings: [
        'golang\\s+(?<currentValue>[\\d\\.]+)',
      ],
      depNameTemplate: 'golang',
      datasourceTemplate: 'golang-version',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)\\.tool-versions$/',
      ],
      matchStrings: [
        'nodejs\\s+(?<currentValue>[\\d\\.]+)',
      ],
      depNameTemplate: 'node',
      datasourceTemplate: 'node-version',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^scripts/setup\\.sh$/',
      ],
      matchStrings: [
        'github\\.com/air-verse/air@v(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'air-verse/air',
      datasourceTemplate: 'github-tags',
    },
  ],
}
