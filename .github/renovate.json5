{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  enabledManagers: [
    'gomod',
    'npm',
    'docker-compose',
    'github-actions',
    'custom.regex',
  ],
  separateMajorMinor: true,
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  // Supply-chain attack hardening: wait 7 days after a release before opening a PR.
  // Compromised versions are usually yanked / disclosed within this window.
  minimumReleaseAge: '7 days',
  // gomodUpdateImportPaths follows module path changes on major upgrades
  // (e.g. dlclark/regexp2 -> dlclark/regexp2/v2, which broke CI on 2026-06-08).
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  schedule: [
    'on Sunday',
  ],
  automerge: true,
  automergeType: 'branch',
  platformAutomerge: true,
  packageRules: [
    // eslint-plugin-react (dep of eslint-config-next) does not support ESLint 10 yet.
    // Remove this constraint once eslint-plugin-react adds ESLint 10 to its peerDependencies.
    // Tracking: https://github.com/jsx-eslint/eslint-plugin-react/issues/3838
    {
      matchPackageNames: ['eslint'],
      matchFileNames: ['frontend/package.json'],
      allowedVersions: '<10.0.0',
    },
    // typescript-eslint does not support TypeScript 7 (tsgo) yet — every
    // published version (8.66.0 latest, 8.66.1-alpha canary) still declares
    // peerDependencies typescript ">=4.8.4 <6.1.0", so bumping TypeScript to 7
    // makes lock file regeneration fail with ERESOLVE in both frontend/ and
    // infra/ (and ESLint then crashes inside typescript-estree even if the peer
    // conflict is forced). Remove this constraint once typescript-eslint widens
    // its peer range.
    // Tracking: https://github.com/typescript-eslint/typescript-eslint/issues/10940
    {
      matchPackageNames: ['typescript'],
      allowedVersions: '<7.0.0',
    },
    // frontend/package.json pins @babel/plugin-transform-runtime to ^7.29.0
    // under the unused @rolldown/plugin-babel optional peer so npm never
    // resolves the 8.x line (which requires @babel/core@^8 and conflicts
    // with workbox-build's @babel/core@^7). Renovate previously rewrote
    // that pin to ^8.0.0 (commit 74496db), which re-broke artifact updates
    // on PR #186. Keep the override on 7.x until vite-plugin-pwa /
    // workbox-build move off Babel 7.
    {
      matchPackageNames: ['@babel/plugin-transform-runtime'],
      matchFileNames: ['frontend/package.json'],
      allowedVersions: '<8.0.0',
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
    },
    {
      matchManagers: [
        'gomod',
      ],
      groupName: 'golang dependencies',
    },
    // Renovate disables indirect Go deps by default. backend/go.mod pulls
    // goldmark / chroma transitively through `replace ../core`, and Renovate's
    // per-directory `go mod tidy` (with replace statements massaged away) cannot
    // see core's direct bumps — so the `// indirect` lines silently go stale and
    // break `go test` in CI. Managing them explicitly makes Renovate bump both
    // files in the same grouped branch.
    {
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'indirect',
      ],
      enabled: true,
    },
    {
      matchManagers: [
        'npm',
      ],
      groupName: 'nodejs dependencies',
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      groupName: 'docker dependencies',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions dependencies',
      pinDigests: true,
    },
    {
      matchPackageNames: [
        'golang',
        'node',
      ],
      groupName: 'tooling versions',
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)\\.tool-versions$/',
      ],
      matchStrings: [
        'golang\\s+(?<currentValue>[\\d\\.]+)',
      ],
      depNameTemplate: 'golang',
      datasourceTemplate: 'golang-version',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)\\.tool-versions$/',
      ],
      matchStrings: [
        'nodejs\\s+(?<currentValue>[\\d\\.]+)',
      ],
      depNameTemplate: 'node',
      datasourceTemplate: 'node-version',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^scripts/setup\\.sh$/',
      ],
      matchStrings: [
        'github\\.com/air-verse/air@v(?<currentValue>[\\d.]+)',
      ],
      depNameTemplate: 'air-verse/air',
      datasourceTemplate: 'github-tags',
    },
  ],
}
