{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":prHourlyLimitNone",
    ":prImmediately",
    ":pinGitHubActionDigests"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "schedule": ["on Sunday"],
  "automerge": true,
  "automergeType": "branch",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "golang dependencies"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "nodejs dependencies"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions dependencies"
    },
    {
      "matchPackageNames": ["golang", "node"],
      "groupName": "tooling versions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["^\\.go-version$"],
      "matchStrings": ["(?<currentValue>.+)"],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["^\\.node-version$"],
      "matchStrings": ["(?<currentValue>.+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "(^|/)Dockerfile\\.dev$",
        "^docker/base\\.Dockerfile$",
        "^docker-compose\\.yml$"
      ],
      "matchStrings": [
        "GO_VERSION[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "depNameTemplate": "golang",
      "datasourceTemplate": "golang-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "(^|/)Dockerfile\\.dev$",
        "^docker/base\\.Dockerfile$",
        "^docker-compose\\.yml$"
      ],
      "matchStrings": [
        "NODE_VERSION[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "(^|/)Dockerfile\\.dev$",
        "^docker-compose\\.yml$"
      ],
      "matchStrings": ["github.com/air-verse/air@v(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "github.com/air-verse/air",
      "datasourceTemplate": "github-tags"
    }
  ]
}
