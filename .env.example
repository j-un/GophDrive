# Loaded by overmind for all processes (backend / frontend / wasm watcher).
# Copy to `.env` and adjust. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Local AWS (DynamoDB Local)
# ---------------------------------------------------------------------------
AWS_ENDPOINT_URL=http://localhost:8000
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ---------------------------------------------------------------------------
# Backend (Go API on :8080)
# ---------------------------------------------------------------------------
DEV_MODE=true
EDITING_SESSIONS_TABLE=EditingSessions
FILE_STORE_TABLE=FileStore
API_KEY_HASHES_TABLE=APIKeyHashes
# Reserved for future S3 spillover (image / file uploads).
# Leave empty for local dev — current code path never reads it.
BODY_STORE_BUCKET=

# Secrets resolved by EnvResolver (DEV_MODE=true)
JWT_SECRET=dev-jwt-secret
GOOGLE_CLIENT_SECRET=dummy
API_GATEWAY_SECRET=dev-api-gw-secret

# Google OAuth — replace with real values to test the live login flow.
# Step-by-step setup: docs/local-google-oauth.md
GOOGLE_CLIENT_ID=dummy
# GOOGLE_REDIRECT_URL is auto-set in DEV_MODE; override only if needed.

FRONTEND_URL=http://localhost:3000
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# ---------------------------------------------------------------------------
# Frontend (Next.js on :3000)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://localhost:8080
# NEXT_PUBLIC_PRIVACY_POLICY_URL=
# NEXT_PUBLIC_TERMS_OF_SERVICE_URL=
